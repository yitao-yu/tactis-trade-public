PYTHONUNBUFFERED=1
TZ=UTC

# IB Gateway paper login (injected by Batch from SSM via secretEnvironment)
IB_GATEWAY_USER=
IB_GATEWAY_PASSWORD=
TRADING_MODE=paper
VNC_SERVER_ENABLED=no
JAVA_HEAP_XMX=1g

# runner
TACTIS_VENUE=ibkr
TACTIS_WEIGHTS_FILE=/tmp/weights.json
TACTIS_FORCE_DRYRUN=1
IB_GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4002
AWS_REGION=us-east-2
